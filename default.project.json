{
  "name": "GolpearYHuirMVP",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "$ignoreUnknownInstances": true,
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 64,
        "StreamingTargetRadius": 512,
        "StreamOutBehavior": "Opportunistic",
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "ModelStreamingBehavior": "Improved"
      }
    },
    "ReplicatedStorage": {
      "$path": "src/ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "EventoJuego": { "$className": "RemoteEvent" },
      "EventoCountdown": { "$className": "BindableEvent" },
      "EventoAtaque": { "$className": "RemoteEvent" },
      "EventoHit1v1": { "$className": "RemoteEvent" },
      "EventoMatchmaking": { "$className": "RemoteEvent" },
      "EventoPale1v1": { "$className": "RemoteEvent" },
      "Sprint1v1": { "$className": "RemoteEvent" },
      "ThrowChairEvent": { "$className": "RemoteEvent" },
      "SolicitarParkour1v1": { "$className": "RemoteFunction" }
    },
    "ServerScriptService": {
      "$path": "src/ServerScriptService",
      "$ignoreUnknownInstances": true
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts",
        "$ignoreUnknownInstances": true
      }
    }
  }
}
